# Django Settings
DEBUG=True
SECRET_KEY=your-secret-key-here

# Database Configuration
DB_ENGINE=django.db.backends.mysql
DB_NAME=neuxo
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-db-password

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=your-redis-password
# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key
TOKEN_TTL_MINUTES=60

# Public Server URL (for email tracking)
PUBLIC_SERVER=https://your-domain.com

# Project Path (for static files)
PROJECT_PATH=/path/to/your/project/

# Email/SMTP Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_SENDERMAIL=your-email@gmail.com
EMAIL_RECIPIENT=recipient@example.com

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# OpenAI/AI Configuration (for gen-email feature)
OPENAI_API_KEY=your-openai-api-key
API_KEY_GEMINI=your-gemini-api-key
